{
  "name": "diff-tool",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform high-performance diff and merge tool prototype.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "preview": "npm --workspace apps/desktop run preview",
    "tauri": "npm --workspace apps/desktop run tauri",
    "check": "npm --workspace apps/desktop run check",
    "test:rust": "CARGO_HOME=${CARGO_HOME:-/tmp/cargo-home} cargo test --workspace",
    "test:fixtures": "CARGO_HOME=${CARGO_HOME:-/tmp/cargo-home} cargo test --workspace",
    "perf": "node scripts/measure-performance.mjs",
    "perf:quick": "node scripts/measure-performance.mjs --quick",
    "test": "npm run check && npm run test:rust",
    "test:mvp": "npm run test && npm run test:e2e:mvp-boundary && npm run test:e2e:cli-all && npm run test:e2e && npm run perf:quick",
    "test:mvp:package": "npm run tauri -- build",
    "test:e2e": "playwright test",
    "test:e2e:cli-smoke": "playwright test tests/e2e/desktop_render_cli_backed.spec.ts",
    "test:e2e:cli-all": "npm run test:e2e:cli && npm run test:e2e:whitespace-ignore && npm run test:e2e:whitespace-case-ignore && npm run test:e2e:folder-scan && npm run test:e2e:error-path && npm run test:e2e:context && npm run test:e2e:progress-diff && npm run test:e2e:progress-dir && npm run test:e2e:config",
    "test:e2e:cli": "node tests/e2e/text_diff_happy_path.test.mjs",
    "test:e2e:whitespace-ignore": "node tests/e2e/whitespace_ignore.test.mjs",
    "test:e2e:whitespace-case-ignore": "node tests/e2e/whitespace_case_ignore.test.mjs",
    "test:e2e:folder-scan": "node tests/e2e/folder_scan_happy_path.test.mjs",
    "test:e2e:error-path": "node tests/e2e/cli_error_path.test.mjs",
    "test:e2e:context": "node tests/e2e/context_flag.test.mjs",
    "test:e2e:progress-diff": "node tests/e2e/progress_diff.test.mjs",
    "test:e2e:progress-dir": "node tests/e2e/progress_dir.test.mjs",
    "test:e2e:config": "node tests/e2e/config_command.test.mjs",
    "test:e2e:mvp-boundary": "node tests/e2e/mvp_boundary.test.mjs",
    "test:e2e:office": "node tests/e2e/office_cli.test.mjs",
    "screenshots": "node apps/desktop/scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
